#!/usr/bin/env bash
# commit-msg hook: every commit gets a new build version (Genor's rule 2026-09-20).
# VERSION = MAJOR.MINOR.PATCH.BUILD — the BUILD segment increments once per
# commit, so the UI chip / /api/system/version always tell you exactly which
# commit is deployed. Runs in commit-msg (not pre-commit) because git only
# writes COMMIT_EDITMSG after pre-commit, and we must see the message to
# honor the escape hatch.
#
# Escape hatches:
#   - commit message containing [no-bump]  → no bump
#   - a commit that only touches VERSION   → no bump (prevents loops)
set -euo pipefail

MSG="${1:-}"
cd "$(git rev-parse --show-toplevel)"

if [ -n "$MSG" ] && [ -f "$MSG" ] && grep -q '\[no-bump\]' "$MSG"; then
  exit 0
fi

STAGED="$(git diff --cached --name-only)"
[ -z "$STAGED" ] && exit 0
if [ -z "$(printf '%s\n' "$STAGED" | grep -v '^VERSION$' || true)" ]; then
  exit 0
fi

if [ ! -f VERSION ]; then
  echo "commit-msg: VERSION file missing — creating 0.1.0.0" >&2
  echo "0.1.0.0" > VERSION
fi

V="$(tr -d '[:space:]' < VERSION)"
if ! printf '%s' "$V" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "commit-msg: VERSION '$V' is not MAJOR.MINOR.PATCH.BUILD — fix it or use [no-bump]" >&2
  exit 1
fi

NEW="$(printf '%s' "$V" | awk -F. '{printf "%d.%d.%d.%d", $1, $2, $3, $4+1}')"
printf '%s\n' "$NEW" > VERSION
git add VERSION
echo "commit-msg: build version $V -> $NEW"
