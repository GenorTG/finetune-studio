#!/usr/bin/env bash
# pre-push: what may reach GitHub (CONTRIBUTING.md "Branches").
#   - never push main or dev directly: they change only through merged PRs
#   - never push the local history archive (full-history, backup/*, archive/*): the remote is public
#   - new branches follow <type>/<slug>, release/vX.Y.Z, hotfix/vX.Y.Z or sync/vX.Y.Z
#   - tags: only vX.Y.Z (scripts/release.py finish)
# Emergency escape for main/dev only (never routine): FTS_ALLOW_PROTECTED_PUSH=1 git push …
set -euo pipefail

policy="$(git rev-parse --show-toplevel)/scripts/branch_policy.py"
zero="0000000000000000000000000000000000000000"
fail=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  [ "$local_sha" = "$zero" ] && continue   # deleting a remote branch/tag is allowed
  case "$remote_ref" in
    refs/heads/full-history|refs/heads/backup/*|refs/heads/archive/*)
      echo "pre-push: '$remote_ref' is the local history archive; it never goes to the (public) remote." >&2
      fail=1 ;;
    refs/heads/main|refs/heads/dev)
      if [ "${FTS_ALLOW_PROTECTED_PUSH:-0}" != "1" ]; then
        echo "pre-push: '${remote_ref#refs/heads/}' changes only through a merged PR (open one from your branch)." >&2
        fail=1
      fi ;;
    refs/heads/*)
      name="${remote_ref#refs/heads/}"
      if ! python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import branch_policy as b; sys.exit(0 if b.branch_name_ok(sys.argv[2]) else 1)' \
           "$(dirname "$policy")" "$name"; then
        echo "pre-push: branch '$name' does not follow <type>/<slug> (feat fix chore docs refactor test ci perf build)," >&2
        echo "  release/vX.Y.Z, hotfix/vX.Y.Z or sync/vX.Y.Z. Rename: git branch -m <new-name>" >&2
        fail=1
      fi ;;
    refs/tags/*)
      tag="${remote_ref#refs/tags/}"
      if ! printf '%s' "$tag" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$'; then
        echo "pre-push: tag '$tag' is not vX.Y.Z; release tags come from scripts/release.py finish." >&2
        fail=1
      fi ;;
  esac
done

exit "$fail"
