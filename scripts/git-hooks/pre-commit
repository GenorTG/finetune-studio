#!/usr/bin/env bash
# pre-commit: branch rules (CONTRIBUTING.md "Branches"), enforced before GitHub's rulesets see anything.
#   - no commits on main or dev: branch from dev (feat/…, fix/…, chore/…), PR back into dev
#   - VERSION changes only on release/vX.Y.Z or hotfix/vX.Y.Z (scripts/release.py does the bump)
# Emergency escape (never routine): FTS_ALLOW_PROTECTED_COMMIT=1 git commit …
set -euo pipefail

branch="$(git symbolic-ref --short -q HEAD || true)"
[ "${FTS_ALLOW_PROTECTED_COMMIT:-0}" = "1" ] && exit 0

case "$branch" in
  main|dev)
    echo "pre-commit: no commits on '$branch'. Branch from dev:" >&2
    echo "  git switch dev && git pull --ff-only && git switch -c feat/<slug>   (or fix/, chore/, docs/ …)" >&2
    exit 1 ;;
esac

if git diff --cached --name-only | grep -qx 'VERSION'; then
  case "$branch" in
    release/v*|hotfix/v*|sync/v*) ;;
    *)
      echo "pre-commit: VERSION changes only on release/hotfix branches (make release-prepare BUMP=…)." >&2
      echo "  unstage it: git restore --staged VERSION && git checkout VERSION" >&2
      exit 1 ;;
  esac
fi
